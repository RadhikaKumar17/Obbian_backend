PORT=4000
HOST=127.0.0.1
FRONTEND_ORIGINS=http://localhost:3000,http://localhost:3100
# Required. A MongoDB connection string, e.g. from a Railway "Add Database" plugin
# or a free MongoDB Atlas cluster: mongodb+srv://user:pass@cluster.mongodb.net/obbian
MONGODB_URI=
# Set a private token before using administrative inventory/tracking endpoints.
ADMIN_TOKEN=
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax
