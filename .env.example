PORT=4000
HOST=127.0.0.1
FRONTEND_ORIGINS=http://localhost:3000,http://localhost:3100
# Required. A MongoDB connection string, e.g. from a Railway "Add Database" plugin
# or a free MongoDB Atlas cluster: mongodb+srv://user:pass@cluster.mongodb.net/obbian
MONGODB_URI=
# Set a private token before using administrative inventory/tracking endpoints.
ADMIN_TOKEN=
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax
# The Obbian RAG policy service (OBBIAN_RAG). Required for /api/policies/ask.
RAG_SERVICE_URL=http://127.0.0.1:8000
RAG_API_KEY=
# Required for /api/assistant (tool-calling AI agent).
GROQ_API_KEY=
ASSISTANT_MODEL=openai/gpt-oss-120b
# Chat memory (mem0.ai). Without it, /api/chats/policy and /api/chats/assistant return empty history.
MEM0_API_KEY=
